# Copy to .env (gitignored) and fill in. In CI these come from repository secrets.

# Anthropic: use a dedicated "butler" workspace key with a monthly spend limit.
ANTHROPIC_API_KEY=

# Telegram bot (from @BotFather) and your own chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail OAuth (Desktop app client from Google Cloud). The refresh token comes from
# running scripts/gmail_auth.py once.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
