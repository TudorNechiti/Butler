# Copy to .env (gitignored) and fill in. In CI these come from repository secrets.

# Anthropic: use a dedicated "butler" workspace key with a monthly spend limit.
ANTHROPIC_API_KEY=

# Telegram bot (from @BotFather) and your own chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail OAuth (Desktop app client from Google Cloud). The refresh token comes from
# running scripts/gmail_auth.py once.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Habit tracker: the sheet id is the long part of the sheet URL between /d/ and /edit.
# The service account key file stays outside the repo (e.g. ~/.secrets/).
# In CI, HABIT_SA_KEY_JSON holds the key file's content instead. Set exactly one.
HABIT_SHEET_ID=
HABIT_SA_KEY_FILE=
# Responder link (forms.gle/...) shown in the evening reminder. Secret: anyone with it can submit.
HABIT_FORM_URL=
